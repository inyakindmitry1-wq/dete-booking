# ==============================================================================
# Multi-Tenant Auto Service & Detailing PWA - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Client Configuration (Public / Safe for Browser)
# ------------------------------------------------------------------------------
# Your Supabase project URL (e.g. https://xyzcompany.supabase.co or local http://127.0.0.1:54321)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Public Key (anon/public key only, zero access to sensitive tables without RLS/functions)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Default tenant slug when navigating to root "/" (fallback when no subdomain / path provided)
VITE_DEFAULT_TENANT=graphite

# Public Web Push VAPID public key (used by clients to register push subscriptions)
VITE_VAPID_PUBLIC_KEY=BDs_your_public_vapid_key_here

# ------------------------------------------------------------------------------
# 2. Server-Side & Supabase Edge Functions Secrets (DO NOT EXPOSE TO BROWSER)
# Set these in Supabase Dashboard > Settings > Edge Functions Secrets
# ------------------------------------------------------------------------------
# Supabase Service Role Key (used only inside trusted Edge Functions for admin operations)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# Web Push VAPID Private Key & Subject (for notifications-worker edge function)
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@example.com

# LLM AI Integration (Edge Function ai-chat)
# Compatible with OpenAI, Groq, OpenRouter, or DeepSeek OpenAI-compatible endpoints
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-llm-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_MAX_TURNS=3
